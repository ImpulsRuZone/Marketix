# OpenAI
OPENAI_API_KEY=sk-...

# PostgreSQL (опционально — если не задан, логирование в БД отключено)
DATABASE_URL=postgresql://user:password@localhost:5432/neurocomment

# Задержка перед отправкой комментария (секунды)
DELAY_MIN=150
DELAY_MAX=600

# Задержка между вступлениями в каналы (секунды)
JOIN_DELAY_MIN=60
JOIN_DELAY_MAX=180

# Максимальная длина комментария (символы)
MAX_COMMENT_LENGTH=200

# Системный промпт для GPT
SYSTEM_PROMPT=Пиши короткие шуточные безобидные комментарии, веди себя как настоящий человек. Длина комментария не более 7 слов.
