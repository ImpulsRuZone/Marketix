# ──────────────────────────────────────────────
# Supabase / PostgreSQL
# Format: postgresql://user:password@host:port/dbname
# Supabase: Settings → Database → Connection string (URI)
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# ──────────────────────────────────────────────
# Telegram API (одна пара на все аккаунты — my.telegram.org)
# ──────────────────────────────────────────────
API_ID=12345678
API_HASH=your_api_hash_here

# ──────────────────────────────────────────────
# OpenAI
# ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ──────────────────────────────────────────────
# Comment settings
# ──────────────────────────────────────────────
MAX_COMMENT_LENGTH=200
MIN_POST_LENGTH=50

# Вступать в новые каналы при старте (для systemd, без интерактива)
# true — вступать; false — только слушать посты
JOIN_ON_STARTUP=false

# ──────────────────────────────────────────────
# Mass-looking defaults (override per account in account_settings)
# ──────────────────────────────────────────────
# masslook_enabled, max_story_views_per_day, story_view_delay_* — в Supabase

# Fallback GPT prompt (can be overridden per account in DB)
DEFAULT_GPT_PROMPT=Пиши короткие шуточные безобидные комментарии, веди себя как настоящий человек. Длина комментария не более 7 слов.
